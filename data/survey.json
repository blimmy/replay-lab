          },
          "maxSelections": 2,
          "exclusiveValues": [
            "not_sure"
          ]
        },
        {
          "id": "childhood_experience",
          "label": "Before adulthood, what was your experience of Squishy or Slime?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "owned",
              "label": "I owned or played with it"
            },
            {
              "value": "wanted",
              "label": "I wanted it but did not own it"
            },
            {
              "value": "knew_not_interested",
              "label": "I knew about it but was not interested"
            },
            {
              "value": "unfamiliar",
              "label": "I was not familiar with it"
            },
            {
              "value": "not_sure",
              "label": "I do not remember"
            }
          ]
        }
      ]
    },
    {
      "id": "concept",
      "title": "Now consider the REPLAY LAB idea",
      "description": "REPLAY LAB is a proposed service for working adults. Customers help choose a shared childhood-memory theme, then personalise a Squishy or Slime design with colour and texture options. The business shows a prototype and an estimated delivery date before taking real pre-orders. Production would begin only if the announced order threshold is met; otherwise customers would receive a refund under the stated terms. The website you may see is a demo: its votes and pre-orders do not reserve products or take payment.",
      "questions": [
        {
          "id": "product_choice",
          "label": "Which would you choose for this concept, if any?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "squishy",
              "label": "Squishy"
            },
            {
              "value": "slime",
              "label": "Slime"
            },
            {
              "value": "neither",
              "label": "Neither"
            },
            {
              "value": "not_sure",
              "label": "Not sure"
            }
          ]
        },
        {
          "id": "purchase_interest",
          "label": "How likely would you be to consider buying from this service?",
          "type": "radio",
          "required": true,
          "options": [
            {
              "value": "very_unlikely",
              "label": "Very unlikely"
            },
            {
              "value": "unlikely",
              "label": "Unlikely"
            },
            {
              "value": "neither",
              "label": "Neither likely nor unlikely"
            },
            {
              "value": "likely",
              "label": "Likely"
            },
            {
              "value": "very_likely",
              "label": "Very likely"
            },
            {
              "value": "not_sure",
              "label": "Not enough information to decide"
            }
          ]
        },
        {
          "id": "valued_features",
          "label": "Which features, if any, would matter most to you? Choose up to TWO.",
          "type": "checkbox",
          "required": true,
          "options": [
            {
              "value": "memory",
              "label": "A design linked to a childhood memory"
            },
            {
              "value": "choice",
              "label": "Choosing colour and texture"
            },
            {
              "value": "prototype",
              "label": "Seeing a prototype before ordering"
            },
            {
              "value": "low_batch",
              "label": "Production only after enough orders"
            },
            {
              "value": "quiet",
              "label": "A quiet / unscented option"
            },
            {
              "value": "price",
              "label": "An affordable total price"
            },
            {
              "value": "quality",
              "label": "Clear material and care information"
            },
            {
              "value": "none",
              "label": "None of these"
            },
            {
              "value": "other",
              "label": "Something else"
            }
          ],
          "maxSelections": 2,
          "exclusiveValues": [
            "none"
          ]
        },
        {
          "id": "max_price_thb",
          "label": "For the hypothetical item described below, what is the highest TOTAL price in THB you would consider paying?",
          "type": "number",
          "required": false,
          "showIf": {
            "id": "product_choice",
            "values": [
              "squishy",
              "slime"
            ]
          },
          "description": "For the next price question, imagine one palm-sized Squishy (about 7 cm) OR one 90 ml Slime jar, according to your selection. It has a shared childhood-themed design, your selected colour and texture, a simple gift box and domestic shipping included. This is a hypothetical specification for research, not a product offer. No delivery date is promised by this survey.",
          "placeholder": "Enter 0 if you would not pay; leave blank if unsure.",
          "min": 0,
          "max": 100000,
          "step": 1
        },
        {
          "id": "main_hesitation",
          "label": "What would make you hesitate or decide not to buy?",
          "type": "textarea",
          "required": false,
          "maxLength": 500,
          "placeholder": "For example, anything unclear or unsuitable. Your own words are most useful."
        }
      ]
    },
    {
